<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CalorieScanner.SettingsPage"
             Title="Settings">

	<ScrollView>
		<VerticalStackLayout Padding="20" Spacing="12">

			<Label Text="Gemini API key" FontAttributes="Bold" />
			<Entry x:Name="KeyEntry" IsPassword="True" Placeholder="Paste your key" />
			<Label FontSize="13" Opacity="0.7"
			       Text="Get a free key at aistudio.google.com. It is stored only on this phone, in secure storage." />

			<Label Text="Model" FontAttributes="Bold" Margin="0,10,0,0" />
			<Entry x:Name="ModelEntry" Placeholder="gemini-3.8-flash" Keyboard="Plain" />
			<Label FontSize="13" Opacity="0.7"
			       Text="Change this if Google retires the default model. Any Gemini model that accepts images works." />

			<Button Text="Save" Clicked="OnSaveClicked" Margin="0,16,0,0" />
			<Label x:Name="SavedLabel" IsVisible="False" Text="Saved." />

		</VerticalStackLayout>
	</ScrollView>
</ContentPage>
