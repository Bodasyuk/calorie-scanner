<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="CalorieScanner.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:CalorieScanner"
    Title="Calorie Scanner"
    Shell.BackgroundColor="{AppThemeBinding Light=#F4FBF9, Dark=#0F1413}"
    Shell.TitleColor="{AppThemeBinding Light=#006A60, Dark=#4DD9C5}"
    Shell.ForegroundColor="{AppThemeBinding Light=#006A60, Dark=#4DD9C5}">

    <ShellContent
        Title="Home"
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="MainPage" />

</Shell>
